{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verdflow.dev/schemas/strategy-v2.schema.json",
  "title": "VerdFlow Strategy v2",
  "type": "object",
  "required": ["schema", "version", "strategy_id", "strategy_version", "display_name", "generator", "roles"],
  "properties": {
    "schema": {"const": "verdflow.strategy"},
    "version": {"const": "2"},
    "strategy_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
    "strategy_version": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "generator": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "entry": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role_key", "display_name", "description", "required", "assignment_policy"],
        "properties": {
          "role_key": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
          "display_name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "assignment_policy": {"enum": ["single", "weighted_pool"]},
          "relationship_rules": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "intent": {"type": "object"},
    "terrain_suitability": {"type": "object"},
    "parameters": {"type": "object"},
    "generation_parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "value_type",
          "default",
          "min",
          "max",
          "step",
          "group",
          "display_name",
          "effect"
        ],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
          "value_type": {"const": "number"},
          "default": {"type": "number"},
          "min": {"type": "number"},
          "max": {"type": "number"},
          "step": {"type": "number", "exclusiveMinimum": 0},
          "group": {"enum": ["quick", "advanced"]},
          "display_name": {"type": "string", "minLength": 1},
          "effect": {"type": "string", "minLength": 1},
          "visible_for_roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"}
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {"type": "object"}
  },
  "additionalProperties": false
}
